# Cloudflare R2 configuration for image storage (Phase 3).
# Copy these keys into Backend/.env and fill in real values, then:
#   1. (optional) npm run migrate:images-r2 -- --dry-run   # preview
#   2. npm run migrate:images-r2                            # migrate existing images + update DB
#
# New admin uploads automatically optimize (resize + WebP) and go to R2 once these are set.

# Cloudflare account id (R2 dashboard -> Overview / "Account ID").
R2_ACCOUNT_ID=

# R2 API token credentials (R2 -> Manage R2 API Tokens -> create token with
# Object Read & Write on the target bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Target bucket name.
R2_BUCKET=nilaloutfits-media

# Public base URL for objects. Either:
#   - a custom domain connected to the bucket, e.g. https://cdn.nilaloutfits.com
#   - or the bucket's public r2.dev URL (enable "Public Development URL" on the bucket)
# No trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.nilaloutfits.com
